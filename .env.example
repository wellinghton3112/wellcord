# Copie para .env.local e preencha. Nunca commite o .env.local!
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Voz WebRTC — TURN opcional (sem isso, usa só STUN).
# Grátis: metered.ca/tools/openrelay (20 GB/mês), expressturn.com (100 GB/mês)
# ou Cloudflare Realtime. Depois de preencher, configure as mesmas vars na Vercel.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
